{
  "name": "typesense-docs",
  "description": "Typesense documentation helps developers install, configure, and use Typesense to build fast, typo-tolerant search experiences for applications.",
  "private": true,
  "license": "GPL-3.0",
  "scripts": {
    "check-md": "NODE_OPTIONS=--openssl-legacy-provider vuepress check-md ./content",
    "dev": "vitepress dev content",
    "build": "NODE_OPTIONS=--max-old-space-size=16384 vitepress build content",
    "preview": "vitepress preview content",
    "serve": "cd content/.vitepress/dist && ln -sfn . docs && http-server .",
    "dev:vuepress": "NODE_OPTIONS=--openssl-legacy-provider vuepress dev content",
    "build:vuepress": "NODE_OPTIONS=--openssl-legacy-provider vuepress build content --no-cache",
    "deploy": "bun run build && aws s3 cp --recursive ./content/.vitepress/dist s3://typesense.org/docs/ --profile typesense && bun run clearCDNCache && bun run scrapeAndIndexDocs",
    "clearCDNCache": "aws cloudfront create-invalidation --no-cli-pager --distribution-id EQQQZ0LBFY66H --paths \"/docs*\" --profile typesense",
    "scrapeAndIndexDocs": "aws ecs run-task --no-cli-pager --task-definition=scrape-index-docs --launch-type=FARGATE --cluster=typesense-docsearch-scraper --overrides=\"{\\\"containerOverrides\\\":[ { \\\"name\\\": \\\"typesense-docsearch-scraper\\\", \\\"environment\\\": [ { \\\"name\\\": \\\"CONFIG\\\", \\\"value\\\": $(node docsearch.config.js | jq -aR .)}] }]}\" --network-configuration='{\"awsvpcConfiguration\": {\"subnets\": [\"subnet-a3816afe\"], \"securityGroups\": [\"sg-07b87fb405e2f1f8f\"], \"assignPublicIp\": \"ENABLED\"}}' --profile=typesense",
    "lint": "NODE_OPTIONS=--openssl-legacy-provider eslint --ext .js,.vue content/.vuepress",
    "lint:fix": "NODE_OPTIONS=--openssl-legacy-provider bun run lint --fix",
    "typesenseServer": "docker run -i -p 8108:8108 -v/tmp/typesense-server-data/:/data typesense/typesense:0.22.1 --data-dir /data --api-key=xyz --listen-port 8108 --enable-cors"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "chalk": "^4.1.1",
    "commander": "^7.2.0",
    "eslint": "^7.20.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-vue": "^7.6.0",
    "esm": "^3.2.25",
    "http-server": "^14.1.1",
    "markdown-it-mathjax3": "^4.3.2",
    "postcss": "^8.4.49",
    "prettier": "^2.2.1",
    "sass": "^1.32.8",
    "sass-loader": "^10.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitepress": "^1.6.3",
    "vue": "^3.5.0",
    "vuepress-plugin-check-md": "^0.0.2",
    "vuepress-plugin-sitemap": "jasonbosco/vuepress-plugin-sitemap",
    "watchpack": "1.6.1"
  },
  "dependencies": {
    "@dovyp/vuepress-plugin-clipboard-copy": "^1.0.0-alpha.7",
    "@lucide/vue": "^1.24.0",
    "@vuepress/plugin-last-updated": "^1.9.7",
    "@vuepress/plugin-medium-zoom": "^1.9.7",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.460.0",
    "markdown-it": "^8.4.2",
    "markdown-it-attrs": "^4.1.4",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "typesense-docsearch-css": "5.0.2-0",
    "typesense-docsearch.js": "5.0.2-0",
    "vue-prism-component": "^2.0.0",
    "vuepress": "1.9.7",
    "vuepress-plugin-latex": "^0.1.3",
    "vuex": "^3.6.2"
  }
}
